{
  "name": "com.posco.arg_mob01",
  "version": "1.2.7",
  "type": "module",
  "scripts": {
    "dev": "npm run copy:wasm && vite dev",
    "dev:chrome": "powershell -Command \"Start-Process chrome -ArgumentList '--user-data-dir=C:\\ChromeDev', '--disable-web-security', 'http://localhost:5173'\"",
    "build": "npm run copy:wasm && vite build",
    "build:debug": "npm run copy:wasm && vite build --mode debug",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check",
    "check:watch": "svelte-kit sync && svelte-check --watch",
    "copy:wasm": "node -e \"const fs = require('fs'); fs.mkdirSync('static/assets', { recursive: true }); fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'static/assets/sql-wasm.wasm'); fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'static/sql-wasm.wasm');\"",
    "postinstall": "npm run copy:wasm",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open": "npx cap open android",
    "app:build": "npm run build && npx cap sync",
    "app:run": "npm run build && npx cap sync && npx cap run android",
    "apk:release": "npm run build && npx cap sync && cd android && .\\gradlew.bat clean assembleRelease && cd ..",
    "apk:debug": "npm run build:debug && npx cap sync && cd android && .\\gradlew.bat clean assembleDebug && cd ..",
    "apk:all": "npm run build && npx cap sync && cd android && .\\gradlew.bat clean assembleRelease assembleDebug && cd ..",
    "zip": "powershell -Command \"Get-ChildItem -Exclude node_modules, .svelte-kit, build, .git, *.zip | Compress-Archive -DestinationPath securescan-ops-source.zip -Force\""
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.16.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "svelte": "^5.19.10",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/privacy-screen": "^8.0.0",
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor-mlkit/barcode-scanning": "^8.0.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/device": "^8.0.2",
    "@capacitor/dialog": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor/toast": "^8.0.0",
    "@capawesome-team/capacitor-file-opener": "^8.0.1",
    "@capgo/capacitor-network-diagnostics": "^8.0.8",
    "jeep-sqlite": "2.8.0",
    "sql.js": "1.11.0",
    "xlsx": "^0.18.5"
  }
}